# Copia este archivo como .env y rellena los valores.

DJANGO_DEBUG=true
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Clave(s) para cifrar los datos clínicos. Para rotar, añade la nueva al principio separada por comas.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡NO la pierdas! Sin ella los historiales cifrados son irrecuperables.
FIELD_ENCRYPTION_KEYS=

# Por defecto SQLite. En producción: postgres://usuario:password@host:5432/fisio
# DATABASE_URL=

# En desarrollo los emails se muestran en la consola.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Fisioterapia <no-reply@example.com>
